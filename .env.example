DATABASE_URL=mysql://user:pass@host:port/db
VITE_OAUTH_PORTAL_URL=http://localhost:3000
VITE_APP_ID=local-dev
OAUTH_SERVER_URL=http://localhost:3000
VITE_ANALYTICS_ENDPOINT=http://localhost:3000
VITE_ANALYTICS_WEBSITE_ID=local
# GA4 frontend tracking (build-time, injected into client/index.html + the app).
# This is the GA4 **Web Data Stream Measurement ID** ("G-XXXXXXXXXX") from
# GA4 Admin → Data Streams → your Web stream — NOT the numeric GA4 *property* id
# (that's the backend GA4_PROPERTY_ID below). Leave blank to keep frontend GA4
# tracking off (the site sends nothing to GA4; Google Ads is unaffected).
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Meta Pixel (frontend, build-time) ──
# Facebook Business Manager → Events Manager → Data Sources → your Pixel.
# The numeric pixel id (e.g. 1234567890123456). Injected into client/index.html
# via Vite's %VITE_...% HTML template substitution. Leave blank to keep the
# Meta Pixel dormant — fbq() never initialises against a fake id, and the
# noscript <img> 404s silently (see index.html for the guard).
VITE_META_PIXEL_ID=

# ── Google Ads (frontend, build-time) ──
# Google Ads account id in "AW-<numeric>" form. Same gtag.js instance already
# loaded for GA4 — no second script tag. Leave blank to fall back to the live
# production account id hard-coded in client/src/lib/conversions.ts.
VITE_GOOGLE_ADS_ACCOUNT_ID=AW-17768263516

# Per-event Google Ads conversion labels. Get each label from Google Ads →
# Tools & Settings → Conversions → <conversion action> → Tag setup → "Use
# Google Tag Manager / Install the tag yourself" — the label is the string
# after the slash in send_to: "AW-XXXXXXXXX/<LABEL>". Any label left blank
# means that event still fires to GA4 but NOT to Google Ads (per-event kill
# switch — no fake conversions). Populate one at a time as they're verified.
VITE_ADS_LABEL_QUOTE_REQUEST=
VITE_ADS_LABEL_CONTACT_FORM_SUBMIT=
VITE_ADS_LABEL_SCHEDULE_SERVICE=
VITE_ADS_LABEL_COMMERCIAL_QUOTE_REQUEST=
VITE_ADS_LABEL_RESIDENTIAL_QUOTE_REQUEST=
VITE_ADS_LABEL_SERVICE_REQUEST=
VITE_ADS_LABEL_REPAIR_REQUEST=
VITE_ADS_LABEL_INSTALLATION_REQUEST=
VITE_ADS_LABEL_REPLACEMENT_REQUEST=
VITE_ADS_LABEL_MAINTENANCE_PLAN_INQUIRY=
VITE_ADS_LABEL_WARRANTY_QUOTE_REQUEST=
VITE_ADS_LABEL_MEMBERSHIP_QUOTE_REQUEST=
VITE_ADS_LABEL_PORTFOLIO_PRICING_REQUEST=

JWT_SECRET=your-jwt-secret
SESSION_SECRET=your-session-secret
RESEND_API_KEY=re_YOURKEY

# Referral form (Supabase)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Internal presentation page (/presentation-2026) access password
VITE_PRESENTATION_PASSWORD=set-a-new-password

# ── SMS provider ──
# ACTIVE: Telnyx (all sends: campaigns, scheduled, appointments, rebate, referral)
# API key: Telnyx portal → Account → Keys & Credentials → API Keys (starts "KEY...").
TELNYX_API_KEY=
# Sender: the 10DLC-registered messaging number, E.164. NEVER hard-coded in
# code — the app reads it from this env var only. The number MUST be assigned
# (in the Telnyx portal) to the messaging profile bound to the approved
# Customer Care 10DLC campaign below, or carriers will filter the messages.
#   Approved campaign — Telnyx Campaign ID: 4b30019f-57fe-9693-5487-67707b2b116c
#   Approved campaign — TCR Campaign ID:    CVTLF1G
# Set this to whatever number is provisioned on that campaign in production.
TELNYX_FROM_NUMBER=
# Webhook signature verification. REQUIRED in production: Telnyx portal →
# Account → Keys & Credentials → Public Key (base64 raw Ed25519 key). In
# production the server REFUSES TO START without it, and inbound webhooks are
# rejected (503) if it is missing — signature checks are never silently skipped.
TELNYX_PUBLIC_KEY=
# Dev/test ONLY: explicitly bypass inbound webhook signature verification when
# you have no public key locally. Ignored in production. A missing public key
# does NOT imply bypass — you must set this flag on purpose.
TELNYX_WEBHOOK_SIGNATURE_BYPASS=false
# LEGACY/DISABLED (July 2026): TextBelt no longer used for sending.
# Do NOT set TEXTBELT_API_KEY — remove it from Netlify env after rotating it off.

# ── Vapi tool webhook (Jessica's sendForm) ──
# Shared secret for POST /api/webhooks/vapi/send-form (the Mechanical-owned
# sendForm endpoint that texts the /qualify booking link via Telnyx). Vapi must
# send it as the `x-vapi-secret` header on that tool's server request. REQUIRED:
# if unset the endpoint refuses every call (503) — it never runs unauthenticated.
# Generate: openssl rand -hex 32. Set the SAME value here and in the Vapi tool's
# server-URL custom header.
VAPI_TOOL_SECRET=

# ── Accounting: QuickBooks Online (Task 7) ──
# Intuit app credentials (developer.intuit.com → your app → Keys & OAuth).
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
# Must EXACTLY match a Redirect URI registered on the Intuit app.
QUICKBOOKS_REDIRECT_URI=https://mechanicalenterprise.com/api/integrations/quickbooks/callback
# sandbox | production — selects the QBO API base host.
QUICKBOOKS_ENVIRONMENT=sandbox
# Sales-document sync poller (Estimates → Opportunity Center).
# Interval in ms between incremental pulls (default 180000 = 3 min; floor 30s).
QUICKBOOKS_POLL_INTERVAL_MS=180000
# Set to "false" to disable the background poller (manual "Sync Now" still works).
QUICKBOOKS_POLL_ENABLED=true
# SAFETY GATE: manual on/off for outbound SMS follow-ups (10DLC is registered).
# Text follow-up tasks are created but never dispatched while this is not "true".
SMS_FOLLOWUPS_ENABLED=false

# ── Secrets encryption (Task 7) ──
# 32-byte key, hex-encoded (64 hex chars). Generate: openssl rand -hex 32
# Encrypts QuickBooks OAuth tokens at rest AND the Google refresh token used by
# Search Console. Rotating it invalidates stored tokens (reconnect required).
# NEVER commit the real value.
ENCRYPTION_KEY=

# ── Google OAuth (shared: Calendar + Google Ads + Search Console + GA4) ──
# One OAuth client is reused across all Google integrations. The SEO Intelligence
# module (Search Console) and the GA4 Analytics module do NOT add a second OAuth
# flow — they reuse this grant and the connection stored by the Google Calendar
# connect flow. Google Cloud console → APIs & Services → Credentials → OAuth 2.0.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Must EXACTLY match a Redirect URI registered on the OAuth client. This is the
# consent-callback used to connect Google; the consent screen must include the
# Search Console scope (see below) for SEO sync to work.
GOOGLE_CALENDAR_REDIRECT_URI=https://mechanicalenterprise.com/api/integrations/google-calendar/callback
# REQUIRED SCOPE for SEO: https://www.googleapis.com/auth/webmasters.readonly
# REQUIRED SCOPE for GA4: https://www.googleapis.com/auth/analytics.readonly
# Both are requested by the connect flow. Connections authorized BEFORE a scope
# was added must RE-CONSENT once (disconnect + reconnect Google) to grant it.

# ── Google Ads API (server, reporting/management — server/googleAds.ts) ──
# Its own OAuth client (falls back to GOOGLE_CLIENT_ID/SECRET above if unset)
# and its own management-API customer_id — NOT the same as
# VITE_GOOGLE_ADS_ACCOUNT_ID above, which is the "AW-<numeric>" conversion-
# tracking id used by the frontend gtag.js snippet. The management customer_id
# is the plain 10-digit account id from the top-right of the Google Ads
# dashboard (e.g. "332-572-0049" — dashes optional, stripped at read time).
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_REDIRECT_URI=
# OPTIONAL since Google's 2026-09-09 policy change: API access is now approved
# per Google Cloud project (Google Ads API Overview page in that project),
# not per developer token — a real, Google-approved token is no longer
# required. Verified against production (2026-09-27): the header still can't
# be blank/omitted (Google rejects that), but any non-empty placeholder value
# works; server/googleAds.ts falls back to one automatically if this is unset.
# Leave blank unless you have a legacy token already on file.
GOOGLE_ADS_DEVELOPER_TOKEN=
# NOTE: the target calendar for appointment sync (including the Vapi bookHVAC
# tool) is DATABASE-DRIVEN — it comes from the connected account's stored
# googleCalendarId (googleCalendarConnections table). It is intentionally NOT a
# global calendar environment variable.

# ── SEO Intelligence (Search Console sync) ──
# The Search Console PROPERTY to sync — must match the property EXACTLY as shown
# in Search Console. Use ONE of these two forms:
#   Domain property:      sc-domain:mechanicalenterprise.com
#   URL-prefix property:  https://mechanicalenterprise.com/   (trailing slash, exact scheme/host)
SEO_GSC_SITE_URL=sc-domain:mechanicalenterprise.com
# Shared secret for the cron/external sync endpoint POST /api/seo/sync.
# Callers must send it as the `x-seo-sync-secret` header. If unset, the endpoint
# is UNAUTHENTICATED (dev only) — always set this in production. Generate: openssl rand -hex 32
SEO_SYNC_CRON_SECRET=
# Monthly organic-leads goal shown on the dashboard (default 80).
SEO_LEADS_GOAL=80
# Max pages per sync to run through the URL Inspection API (quota-limited; default 20).
SEO_INSPECT_LIMIT=20
# Set to "false" to disable the in-process daily sync scheduler on an instance
# (e.g. when an external cron drives POST /api/seo/sync, or on all-but-one replica).
# Safe to leave enabled everywhere: a MySQL advisory lock ensures only one runs.
SEO_SYNC_SCHEDULER_ENABLED=true
# Optional fallback origin used to turn Search Console page paths into full URLs
# when SEO_GSC_SITE_URL is a domain property (default https://mechanicalenterprise.com/).
PUBLIC_SITE_URL=https://mechanicalenterprise.com/

# ── SEO bulk-approve PR flow (docs/seo-bulk-approve-spec.md) ──
# Fine-grained GitHub Personal Access Token, scoped ONLY to the
# RosaliaGroup/-hvac-campaigns-essex repo, with repository permissions:
#   Contents: Read and write   (commits the overrides file to a pr-seo-meta-* branch)
#   Pull requests: Read and write   (opens/updates the PR; NEVER merges one)
# Generate at github.com/settings/personal-access-tokens/new. Server-side only —
# never sent to the client. Leave blank to keep "Bulk Approve" disabled; the UI
# shows a clear "GitHub not configured" state instead of a confusing failure.
# This flow never pushes to main, never merges a PR, and never triggers a
# deploy hook directly — every write lands on a pr-seo-meta-* or revert-* branch.
SEO_GITHUB_TOKEN=

# ── SEO AI drafting provider ──
# "anthropic" selects the real drafting provider (title + meta description
# only — H1/FAQ/schema/content stay the deterministic mock either way, see
# server/services/seo/ai/anthropicProvider.ts). Anything else, or a missing
# ANTHROPIC_API_KEY below, falls back to the mock placeholder provider —
# never throws, never silently no-ops; the CRM's aiProviderStatus reflects
# whichever is actually active and disables "Approve to PR" while it's mock.
SEO_AI_PROVIDER=

# Shared with the Take-Off flow (server/_core/anthropic.ts) — one key, every
# Anthropic caller in this app reads the same env var. console.anthropic.com.
ANTHROPIC_API_KEY=
# Optional model override for SEO drafting specifically (default claude-sonnet-5,
# falls back to claude-haiku-4-5 if unavailable). Independent of Take-Off's
# TAKEOFF_MODEL_QUICK/PRECISE — those don't affect SEO drafting.
SEO_AI_MODEL=

# ── SEO autopublish (docs/seo-automation-spec.md, docs/seo-automation-addendum-autopublish.md) ──
# Everything below is OFF by default — safe to deploy with none of it set.

# Nightly title/meta draft job — 02:00 America/New_York, Mon-Sat. Once the meta
# lane is warmed up (2 clean manual batches) AND the circuit breaker is clear,
# the job auto-approves its own drafts to a PR (label "auto-YYYYMMDD"), which
# enters the hold-and-veto auto-merge path. Before that, it stages drafts only.
SEO_NIGHTLY_DRAFTS_ENABLED=false

# Weekly B2B content pipeline — same warmed-up/circuit-clear auto-approve
# behavior as the nightly job, for the content lane (8 clean manual posts).
SEO_CONTENT_PIPELINE_ENABLED=false
# Optional: override the weekly cadence without a code change. Standard
# 5-field cron (minute hour day-of-month month day-of-week); day-of-month and
# month must be "*", minute/hour must each be a single exact value (no lists,
# no step syntax) — this scheduler runs once at a specific time, not on a
# repeating interval. Timezone is always America/New_York. Default (unset or
# invalid): "0 6 * * 3" — Wednesdays 06:00 ET.
SEO_CONTENT_SCHEDULE=

# Master switch for the whole auto-lane (addendum §A5: "kills both lanes
# immediately"). While false, the nightly/weekly jobs stage drafts only —
# they never call approveBatchToPR themselves even once a lane is warmed up —
# and the merge poller doesn't run. Existing held batches simply stay open;
# nothing is force-closed. A human's own "Approve to PR" click still works
# and still opens a normal PR either way; it just won't get an auto-merge hold
# while this is false.
SEO_AUTOPUBLISH_ENABLED=false
# Hours an auto-approved batch waits before merging (if the preview is green,
# nobody vetoed, and nobody commented). Default 24, minimum enforced 6.
SEO_AUTOPUBLISH_HOLD_HOURS=24

# HMAC signing key for the unauthenticated veto link emailed on every held
# batch (GET/POST /api/seo/action). Any long random string — e.g.
# `openssl rand -hex 32`. Leave blank to keep veto links (and the whole
# hold-and-veto flow) disabled; the CRM shows a clear "not configured" state.
SEO_ACTION_LINK_SECRET=

# Where hold notifications (with the veto link) and nightly/weekly summary
# emails go. Leave blank to disable email notifications — the jobs still run
# and log to the console either way.
SEO_ALERT_EMAIL=

# Critic-pass model for the content lane's fact-check pass (addendum §A3) —
# a SEPARATE call/prompt from drafting, sees only the finished post + verified
# facts. Defaults to this repo's "precise" tier (claude-opus-4-8, same
# fallback chain as server/_core/anthropic.ts). Independent of SEO_AI_MODEL.
SEO_CRITIC_MODEL=

# ── GA4 Analytics (Google Analytics Data API sync) ──
# The GA4 PROPERTY ID to sync — the NUMERIC id from GA4 Admin → Property Settings
# (e.g. "480827123"). NOT the "G-XXXXXXX" measurement id and NOT a "UA-…" id; a
# non-numeric value is rejected and analytics stays disabled. Leave blank to keep
# the whole GA4 module dormant. A "properties/480827123" form is also accepted.
GA4_PROPERTY_ID=
# Shared secret for the cron/external sync endpoint POST /api/analytics/ga4/sync.
# Callers must send it as the `x-ga4-sync-secret` header. If UNSET the endpoint is
# DISABLED (503) — it never runs unauthenticated. Generate: openssl rand -hex 32
GA4_SYNC_CRON_SECRET=
# In-process daily sync scheduler. OPT-IN and OFF by default: it only starts when
# set to exactly "true". Leave unset/blank to keep automated GA4 syncing disabled.
GA4_SYNC_SCHEDULER_ENABLED=
# Optional rolling window (days) pulled each sync (default 90).
GA4_WINDOW_DAYS=90

# ── Growth system (docs/growth-system-spec.md) — speed-to-lead, follow-up
# cadence, review engine, contact import, scoreboard ──
# Kill switches. Default TRUE (owner wants live speed-to-lead/cadence + reviews):
# set to exactly "false" to disable.
GROWTH_SMS_ENABLED=
GROWTH_CALLS_ENABLED=
REVIEWS_ENABLED=
# Auto-post drafted review responses. Default FALSE — the owner approves responses
# manually until this is explicitly set to "true".
REVIEWS_AUTOREPLY=false

# Owner SMS alert phone (E.164 or 10-digit US) for commercial/bid/portfolio leads,
# "quote from another company" mentions, and low (1-3) review scores. Deliberately
# bypasses the customer SMS compliance gate — this is a staff alert, not marketing.
# Leave blank to disable this channel (a no-op, not an error).
OWNER_ALERT_PHONE=

# Google Business Profile short review link, sent in the review-engine's 4-5-score
# thank-you and in the T+3-day reminder (spec §5 default: link included for everyone).
GBP_REVIEW_LINK=

# National DNC scrub provider seam (shared/dncScrubProvider.ts). No provider is
# integrated yet — leave unset/"null" to keep the safe default (email-only for any
# contact without an established customer/opt-in relationship). Wiring a real
# provider is future work; do not set this to anything but "null" until one exists.
DNC_SCRUB_PROVIDER=

# Outbound Vapi (Jessica) calling for the growth system — a HARD credential-presence
# gate, separate from GROWTH_CALLS_ENABLED. ALL THREE must be set for any growth
# cadence/speed-to-lead/review-engine call to actually go out; otherwise that step
# is skipped (never errors) and falls back to SMS/email only. Currently UNSET in
# production — server/services/growth/outboundCall.ts's makeOutboundCall() call is
# the first real caller of server/integrations/vapi.ts's makeOutboundCall on main.
VAPI_API_KEY=
VAPI_OUTBOUND_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# ── Daily Market Intelligence Report (docs/market-intel-spec.md) ──
# Everything below is OFF by default — safe to deploy with none of it set.

# Master switch. While false the scheduler doesn't even arm, and
# runMarketIntelReport() itself also no-ops (belt-and-suspenders — same
# pattern as SEO_AUTOPUBLISH_ENABLED). No writes, no email, no DB rows.
SEO_INTEL_ENABLED=false
# Standard 5-field cron (minute hour day-of-month month day-of-week; see
# shared/cronTiming.ts's parseCronToSchedule for the supported subset — day-of-
# month/month must be "*", minute/hour a single exact value). Timezone is
# always America/New_York. Default (unset or invalid): "0 6 * * *" — 06:00 ET
# daily. The Monday 06:30 ET weekly roll-up (§6) is not overridable via env.
SEO_INTEL_SCHEDULE=
# Kill switch for the Jessica prompt gap adjustment (§3d): while false
# (default), a caller-question gap is only ever added to the in-report
# pendingPromptAdditions list — the live Vapi prompt is never touched. NOTE:
# even set to "true", no automatic prompt-file write is implemented in this
# first pass (no "Jessica unanswered-question log" data source exists yet in
# this codebase to drive it) — see server/services/seo/intel/adjustments.ts's
# build report for the gap. Reserved for when that data source and the actual
# prompt-file write path are both built.
SEO_INTEL_UPDATE_VAPI=false
# §7: "a report with zero material items... sends no email unless
# SEO_INTEL_ALWAYS_EMAIL=true." Leave unset/false to only email on days with
# at least one suggestion. Uses the SAME SEO_ALERT_EMAIL address as the
# autopublish/nightly-draft notifications above.
SEO_INTEL_ALWAYS_EMAIL=false
# Optional: SerpAPI/DataForSEO/Ahrefs provider name. Leave blank to skip §2.3
# SERP checks entirely (the report still runs on GSC + competitor-watch data).
# No provider integration is implemented yet even when set — see
# server/services/seo/intel/serpChecks.ts's header (first-pass gap, reported).
SEO_SERP_PROVIDER=
